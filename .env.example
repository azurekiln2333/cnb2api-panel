# Generate two DIFFERENT random ASCII secrets, each at least 12 characters.
PANEL_ADMIN_KEY=
GATEWAY_KEY=
# The HTTPS origin shared by the console, registration callbacks and API.
PANEL_PUBLIC_URL=https://ai.example.com

# Listening port for plain Node, or published host port for Docker.
# The Docker container always listens on port 9002.
PANEL_PORT=9002

# Plain Node only. Compose fixes the container host and data path.
PANEL_HOST=127.0.0.1
PANEL_DATA_DIR=./data

# Compose: publish on the host loopback interface for host Nginx.
# Set to 0.0.0.0 only when intentionally accessing the published port from outside.
PANEL_BIND_HOST=127.0.0.1
# Optional: use a version tag or an alternate container registry.
PANEL_IMAGE=docker.cnb.cool/azurekiln/cnb2api-panel:latest

# Configure SSO in the console. Settings are saved in data/panel.json.
# Optional environment bootstrap for new installations is documented in README.md.
