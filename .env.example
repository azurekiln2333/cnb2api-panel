# Generate two DIFFERENT random ASCII secrets, each at least 12 characters.
PANEL_ADMIN_KEY=
GATEWAY_KEY=
# The HTTPS origin shared by the console, registration callbacks and API.
PANEL_PUBLIC_URL=https://ai.example.com

# Plain Node settings. Compose supplies its own container host/port/data path.
PANEL_HOST=127.0.0.1
PANEL_PORT=9002
PANEL_DATA_DIR=./data

# Compose: publish on the host loopback interface for host Nginx.
# Set to 0.0.0.0 only when intentionally accessing port 9002 from outside.
PANEL_BIND_HOST=127.0.0.1
# Optional: use a version tag or an alternate container registry.
PANEL_IMAGE=docker.cnb.cool/azurekiln/cnb2api-panel:latest

# Optional OIDC bootstrap. You can also configure SSO in the console.
# Use your provider's issuer, not its /oauth2/authorize URL.
PANEL_SSO_ENABLED=false
PANEL_KEY_LOGIN_ENABLED=true
PANEL_OIDC_ISSUER=
PANEL_OIDC_CLIENT_ID=
PANEL_OIDC_CLIENT_SECRET=
PANEL_OIDC_SCOPES=openid profile email
PANEL_OIDC_PROVIDER_NAME=SSO
# Comma-separated explicit administrators. Subjects are the provider's user IDs.
PANEL_OIDC_ALLOWED_SUBJECTS=
# Email access also requires email_verified=true from the identity provider.
PANEL_OIDC_ALLOWED_EMAILS=
